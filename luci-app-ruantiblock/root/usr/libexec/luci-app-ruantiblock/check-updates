#!/bin/sh

set -u

API_URL="${RUANTIBLOCK_UPDATE_API_URL:-https://api.github.com/repos/numbereleven-a/ruantiblock_openwrt_forge/releases/latest}"
CURRENT_VERSION=""
VERSION_FILE="/usr/share/ruantiblock/version"
RUN_DIR="/var/run/luci-app-ruantiblock"
PID_FILE="${RUN_DIR}/update-check.pid"
FETCH_PID=""

if [ -r "$VERSION_FILE" ]; then
	CURRENT_VERSION="$(tr -d '\r\n' < "$VERSION_FILE")"
fi

if ! mkdir -m 0755 -p "$RUN_DIR" 2>/dev/null; then
	exit 1
fi

TMP_FILE="$(mktemp -t ruantiblock-update.XXXXXX 2>/dev/null)" || exit 1
ERR_FILE="${TMP_FILE}.err"

cleanup() {
	if [ -n "$FETCH_PID" ] && [ -r "$PID_FILE" ] &&
		[ "$(cat "$PID_FILE" 2>/dev/null)" = "$FETCH_PID" ]; then
		rm -f "$PID_FILE"
	fi
	rm -f "$TMP_FILE" "$ERR_FILE"
}

trap cleanup EXIT HUP INT TERM


/bin/uclient-fetch \
	--quiet \
	--timeout=15 \
	--user-agent="Ruantiblock-LuCI/${CURRENT_VERSION:-unknown}" \
	--header='Accept: application/vnd.github+json' \
	--header='X-GitHub-Api-Version: 2022-11-28' \
	-O "$TMP_FILE" "$API_URL" 2>"$ERR_FILE" &
FETCH_PID=$!
printf '%s\n' "$FETCH_PID" > "$PID_FILE"
wait "$FETCH_PID" || exit 1

TAG_NAME="$(/usr/bin/jsonfilter -q -i "$TMP_FILE" -e '@.tag_name' 2>/dev/null)"

case "$TAG_NAME" in
	''|*[!0-9A-Za-z.-]*) exit 1 ;;
esac

printf '%s\n' "$TAG_NAME"
