#!/bin/sh

RUN_DIR="/var/run/luci-app-ruantiblock"
PID_FILE="${RUN_DIR}/update-check.pid"

if [ -r "$PID_FILE" ]; then
	PID="$(cat "$PID_FILE" 2>/dev/null)"
	case "$PID" in
		''|*[!0-9]*) PID="" ;;
	esac

	if [ -n "$PID" ] && [ "$(cat "/proc/${PID}/comm" 2>/dev/null)" = "uclient-fetch" ]; then
		kill "$PID" 2>/dev/null || true
	fi
	rm -f "$PID_FILE"
fi

exit 0
