Info() {
    local _update_status _user_entries_status _inst
    if [ -f "$UPDATE_STATUS_FILE" ]; then
        _update_status=$($AWK_CMD '
            BEGIN {
                out = "{\"status\":false}";
            }
            NR == 1 {
                if(NF >= 4) {
                    out = sprintf("{\"status\":true,\"date\":\"%s\",\"cidr\":\"%s\",\"ip\":\"%s\",\"fqdn\":\"%s\"}", $4, $1, $2, $3);
                };
                exit;
            }
            END {
                printf "%s", out;
            }' "$UPDATE_STATUS_FILE")
    else
        _update_status="{\"status\":false}"
    fi
    if [ -f "$USER_ENTRIES_STATUS_FILE" ]; then
        _user_entries_status=$($AWK_CMD '
        BEGIN {
            items = 0;
            printf "[";
        }
        {
            if(NF == 4) {
                gsub(/\\/, "\\\\", $4);
                gsub(/"/, "\\\"", $4);
                gsub("/", "\\/", $4);
                if(items >= 1) {
                    printf ",";
                };
                printf "{\"id\":\"%s\",\"cidr\":\"%s\",\"ip\":\"%s\",\"fqdn\":\"%s\"}", $4, $1, $2, $3;
                items++;
            };
        }
        END {
            printf "]";
        }' "$USER_ENTRIES_STATUS_FILE")
    else
        _user_entries_status="[]"
    fi
    NftListBllistChainJson 2> /dev/null | $AWK_CMD -v UPDATE_STATUS="$_update_status" -v USER_ENTRIES_STATUS="$_user_entries_status" '
        BEGIN {
            rules_str = "";
        }
        {
            rules_str = rules_str $0;
        }
        END {
            if(NR == 0) {
                printf "{\"status\": \"disabled\"}";
                exit 1;
            } else {
                printf "{\"status\":\"enabled\",\"last_blacklist_update\":%s,\"user_entries\":%s,\"rules\":%s", UPDATE_STATUS, USER_ENTRIES_STATUS, rules_str;
                exit 0;
            };
        }'
    if [ $? -eq 0 ]; then
        local _set_json
        _set_json=$($NFT_CMD -j list set $NFT_TABLE "$NFTSET_DNSMASQ" 2> /dev/null)
        printf ",\"dnsmasq\":%s" "${_set_json:-{}}"
        printf ",\"dnsmasq_user_instances\":["
        for _inst in $USER_INSTANCES_ALL
        do
            _set_json=$($NFT_CMD -j list set $NFT_TABLE "${NFTSET_DNSMASQ}.${_inst}" 2> /dev/null)
            if [ -n "$_set_json" ]; then
                printf "%s," "$_set_json"
            fi
        done
        printf "{\"dummy\": {}}]"
        if [ "$BYPASS_MODE" = "1" ]; then
            _set_json=$($NFT_CMD -j list set $NFT_TABLE "$NFTSET_BYPASS_FQDN" 2> /dev/null)
            printf ",\"dnsmasq_bypass\":%s" "${_set_json:-{}}"
        fi
        printf "}"
    fi
}
